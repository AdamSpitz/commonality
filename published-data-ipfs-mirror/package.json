{
  "name": "@commonality/published-data-ipfs-mirror",
  "version": "0.1.0",
  "description": "Permissionless asynchronous IPFS mirror for PublishedData calldata",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
