    "pretest": "npm run build",
    "test": "mocha \"dist/test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@commonality/sdk": "*",
    "viem": "2.54.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "mocha": "^10.8.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.46.4"
  }
}
