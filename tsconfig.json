{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "mocha"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "sdk/src/**/*.ts",
    "sdk/abis/**/*.ts",
    "services/*/src/**/*.ts",
    "indexer/**/*.ts",
    "service-host/src/**/*.ts",
    "platform-api-service/src/**/*.ts",
    "published-data-ipfs-mirror/src/**/*.ts",
    "coherence-badge-worker/src/**/*.ts",
    "alignment-trust-bootstrap/src/**/*.ts",
    "fake-data-generation/*.ts",
    "integration-tests/src/**/*.ts",
    "ui/src/**/*.ts",
    "ui/src/**/*.tsx",
    "cause-assist/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".turbo"]
}
