{
  "id": "facet.product",
  "description": "Does it make sense to users? Covers messaging, workflow clarity, usability reviews, demo readiness, and QA synthesis.",
  "trigger": {
    "type": "onInputChange",
    "debounceMinutes": 1
  },
  "retention": {
    "keep": 10,
    "keepDays": 30
  },
  "command": [
    "node",
    "checks/supervisor.mjs"
  ],
  "inputs": [
    {
      "kind": "check",
      "id": "product.messaging",
      "role": "product-subfacet"
    },
    {
      "kind": "check",
      "id": "product.workflows",
      "role": "product-subfacet"
    },
    {
      "kind": "check",
      "id": "product.manual-attestations",
      "role": "product-subfacet"
    },
    {
      "kind": "params",
      "data": {
        "label": "facet.product",
        "rollup": {
          "type": "anyFail"
        },
        "freshness": {
          "requiredMaxAgeMinutes": 10080
        }
      }
    }
  ],
  "timeoutMs": 30000
}
