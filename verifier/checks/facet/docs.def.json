{
  "id": "facet.docs",
  "description": "Do the docs cohere? Combines documentation judgment with a deterministic broken-reference scan.",
  "trigger": {
    "type": "onInputChange",
    "debounceMinutes": 1
  },
  "retention": {
    "keep": 10,
    "keepDays": 30
  },
  "command": [
    "node",
    "checks/supervisor.mjs"
  ],
  "inputs": [
    {
      "kind": "check",
      "id": "review.docs-coherence",
      "role": "product-judgment"
    },
    {
      "kind": "check",
      "id": "review.docs-broken-refs",
      "role": "coverage"
    },
    {
      "kind": "params",
      "data": {
        "label": "facet.docs",
        "rollup": {
          "type": "anyFail"
        },
        "freshness": {
          "requiredMaxAgeMinutes": 10080
        }
      }
    }
  ],
  "timeoutMs": 30000
}
