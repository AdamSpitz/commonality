{
  "id": "root",
  "description": "Ready to deploy? Rolls up functionality, docs, product, security, and verifier-health into one gating status, then writes the milestone-framed report.md narrative. The narrative never affects gating.",
  "cost": "llm",
  "trigger": {
    "type": "onInputChange",
    "debounceMinutes": 1
  },
  "retention": {
    "keep": 10,
    "keepDays": 30
  },
  "command": [
    "node",
    "checks/root.mjs"
  ],
  "memoize": false,
  "inputs": [
    {
      "kind": "check",
      "id": "facet.functionality",
      "role": "facet"
    },
    {
      "kind": "check",
      "id": "facet.docs",
      "role": "facet"
    },
    {
      "kind": "check",
      "id": "facet.product",
      "role": "facet"
    },
    {
      "kind": "check",
      "id": "facet.security",
      "role": "facet"
    },
    {
      "kind": "check",
      "id": "meta.verifier-health",
      "role": "verifier-health"
    },
    {
      "kind": "check",
      "id": "meta.backlog-reminder",
      "role": "backlog-reminder"
    },
    {
      "kind": "file",
      "path": "milestone.json",
      "as": "milestone"
    },
    {
      "kind": "params",
      "data": {
        "label": "root",
        "rollup": {
          "type": "anyFail"
        },
        "advisoryCheckIds": [
          "meta.backlog-reminder"
        ],
        "commandTimeoutMs": 600000,
        "maxFindingsChars": 8000,
        "taskKind": "clear-communication",
        "freshness": {
          "requiredMaxAgeMinutes": 1440,
          "byIdMinutes": {
            "meta.verifier-health": 120
          }
        }
      }
    }
  ],
  "timeoutMs": 630000,
  "display": {
    "preferredArtifact": "report.md"
  }
}
