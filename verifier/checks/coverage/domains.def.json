{
  "id": "coverage.domains",
  "description": "Verify Commonality has an intentional smoke/review/docs coverage story. Extracted political apps belong to common-sense-politics; other Vite domains are supporting tools outside this inventory.",
  "expense": {
    "llm": "none",
    "estimatedSeconds": 2
  },
  "trigger": {
    "type": "cron",
    "everyMinutes": 720
  },
  "retention": {
    "keep": 10,
    "keepDays": 30
  },
  "command": [
    "node",
    "checks/coverage/domains.mjs"
  ],
  "inputs": [
    {
      "kind": "file",
      "path": "coverage/domains.json",
      "as": "domainsInventory"
    },
    {
      "kind": "file",
      "path": "../specs/product/ui-domains.md",
      "as": "uiDomainsDoc"
    }
  ],
  "timeoutMs": 30000
}
