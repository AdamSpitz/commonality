{
  "id": "coverage.workflows",
  "description": "Verify the Commonality workflow inventory maps each required workflow to a workflow-clarity check, objective smoke, and existing surface files. Political app workflows are owned by common-sense-politics.",
  "expense": {
    "llm": "none",
    "estimatedSeconds": 2
  },
  "trigger": {
    "type": "cron",
    "everyMinutes": 720
  },
  "retention": {
    "keep": 10,
    "keepDays": 30
  },
  "command": [
    "node",
    "checks/coverage/workflows.mjs"
  ],
  "inputs": [
    {
      "kind": "file",
      "path": "coverage/workflows.json",
      "as": "workflowsInventory"
    },
    {
      "kind": "file",
      "path": "../specs/product/ui-domains.md",
      "as": "uiDomainsDoc"
    }
  ],
  "timeoutMs": 30000
}
