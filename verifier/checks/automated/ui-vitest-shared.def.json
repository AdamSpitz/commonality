{
  "id": "automated.ui-vitest-shared",
  "description": "Run UI Vitest shared component/hook/store/trust tests.",
  "expense": {
    "llm": "none",
    "estimatedSeconds": 300
  },
  "trigger": {
    "type": "manual"
  },
  "retention": {
    "keep": 3,
    "keepDays": 14
  },
  "command": [
    "node",
    "checks/automated/run-command-check.mjs"
  ],
  "inputs": [
    {
      "kind": "params",
      "data": {
        "label": "npm run test:vitest --workspace=@commonality/ui -- src/shared",
        "command": [
          "npm",
          "run",
          "test:vitest",
          "--workspace=@commonality/ui",
          "--",
          "src/shared"
        ],
        "commandTimeoutMs": 180000,
        "cwd": ".."
      }
    }
  ],
  "timeoutMs": 210000
}
