{
  "id": "meta.liveness",
  "description": "Watchdog: flags verifier checks that have never run or are overdue.",
  "expense": {
    "llm": "none",
    "estimatedSeconds": 2
  },
  "trigger": {
    "type": "cron",
    "everyMinutes": 30
  },
  "retention": {
    "keep": 5,
    "keepDays": 14
  },
  "command": [
    "node",
    "checks/meta/liveness.mjs"
  ],
  "timeoutMs": 30000
}
