export FORCE_COLOR=1  # helps lazygit show color

# Refuse direct commits on master/dev — work goes through feature branches + PRs.
. "$(dirname "$0")/protected-branch-guard.sh"
protected_branch_guard commit

# Validate doc links whenever any prose doc changes (cheap, offline).
# docs/chats is raw transcripts, not maintained prose — see check-docs-links.sh.
if git diff --cached --name-only | grep -vE '^docs/chats/' | grep -qE '\.md$'; then
  echo "Checking docs links..."
  npm run check:docs-links || exit 1
fi

# Skip build and tests if only documentation files changed
if git diff --cached --name-only | grep -qvE '\.(txt|md|gitignore)$'; then
  verifier-run automated.lint && verifier-run automated.build && verifier-run automated.test-fast
else
  echo "Only .txt/.md/.gitignore files changed, skipping build and tests"
fi
