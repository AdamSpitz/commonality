{
  "name": "@commonality/cause-assist",
  "version": "0.1.0",
  "description": "LLM statement suggester and safety filter for CauseStarter (Grok 4.5 / xAI)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && mocha \"dist/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@commonality/attester-core": "0.1.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.1",
    "mocha": "^10.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.46.4"
  }
}
