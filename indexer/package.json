{
  "name": "commonality-indexer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/raw-log-prototype.ts --local --serve 42069 --host 0.0.0.0",
    "dev:no-ui": "tsx scripts/raw-log-prototype.ts --local --serve 42069 --host 0.0.0.0",
    "start": "tsx scripts/raw-log-prototype.ts --hosted --local --serve 42069 --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run check-abis",
    "test": "node --import tsx --test src/rpc/ethGetLogsRangeGuard.test.ts src/rpc/monthlyCapacity.test.ts src/rpc/idleHeadCache.test.ts src/api/projectReadDemand.test.ts src/api/eventSegments.test.ts src/api/eventCursor.test.ts src/api/syncWatermark.test.ts src/indexing/contractCapabilities.test.ts src/indexing/conceptspaceConfigGraph.test.ts src/prototype/*.test.ts",
    "build": "tsc",
    "check-abis": "tsx scripts/sync-abis.ts --check",
    "clean": "rm -rf .ponder",
    "sync-abis": "tsx scripts/sync-abis.ts",
    "prototype": "tsx scripts/raw-log-prototype.ts",
    "test:prototype": "node --import tsx --test src/prototype/*.test.ts"
  },
  "dependencies": {
    "abitype": "^0.10.2",
    "hono": "^4.5.0",
    "viem": "2.54.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=18.14"
  }
}
